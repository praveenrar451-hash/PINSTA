<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Messages • PINSTA</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .chat-container {
            display: flex;
            height: calc(100vh - 110px);
            max-width: 600px;
            margin: 0 auto;
            border: 1px solid #262626;
            background: #000;
        }
        .chat-sidebar {
            width: 100%;
            display: flex;
            flex-direction: column;
            padding: 15px;
        }
        .chat-window {
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 100%;
        }
        .chat-header-bar {
            padding: 12px 15px;
            border-bottom: 1px solid #262626;
            display: flex;
            align-items: center;
            gap: 10px;
            background: #000;
        }
        .chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .msg-bubble {
            max-width: 70%;
            padding: 10px 14px;
            border-radius: 18px;
            font-size: 14px;
            word-break: break-word;
        }
        .msg-bubble.sent {
            background: #0095f6;
            color: #fff;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
        }
        .msg-bubble.received {
            background: #262626;
            color: #fff;
            align-self: flex-start;
            border-bottom-left-radius: 4px;
        }
        .msg-time {
            font-size: 10px;
            color: #a8a8a8;
            margin-top: 3px;
            text-align: right;
        }
        .chat-input-area {
            display: flex;
            padding: 12px;
            border-top: 1px solid #262626;
            background: #000;
        }
        .chat-input-area input {
            flex: 1;
            background: #121212;
            border: 1px solid #363636;
            padding: 10px 15px;
            border-radius: 20px;
            color: #fff;
            outline: none;
        }
        .chat-input-area button {
            background: none;
            border: none;
            color: #0095f6;
            font-weight: 600;
            padding: 0 15px;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <nav class="navbar">
        <h2>Messages</h2>
        <a href="/logout" style="color: #ed4956; text-decoration: none; font-size: 13px; font-weight: 600;">Logout</a>
    </nav>

    <div class="container" style="padding: 0; margin-top: 10px;">
        <div class="chat-container">
            <% if (!chatUser) { %>
                <!-- User Search Panel inside Chat -->
                <div class="chat-sidebar">
                    <h3 style="font-size: 16px; margin-bottom: 12px;">Direct Messages</h3>
                    <input type="text" id="chatSearchInput" placeholder="Search username to chat..." onkeyup="performChatSearch()" style="width: 100%; padding: 10px; background: #121212; border: 1px solid #363636; border-radius: 6px; color: #fff; margin-bottom: 15px; outline: none;">
                    <div id="chatSearchResults" style="overflow-y: auto; flex: 1;">
                        <p style="color: #666; font-size: 13px; text-align: center; margin-top: 40px;">Search a username to start chatting.</p>
                    </div>
                </div>
            <% } else { %>
                <!-- Active Chat Window -->
                <div class="chat-window">
                    <div class="chat-header-bar">
                        <a href="/chat" style="color: #fff; text-decoration: none; font-size: 18px; margin-right: 5px;">←</a>
                        <b style="font-size: 15px;">@<%= chatUser.username %></b>
                    </div>
                    <div id="messagesBox" class="chat-messages">
                        <% messages.forEach(m => { %>
                            <div class="msg-bubble <%= m.sender === user.username ? 'sent' : 'received' %>">
                                <div><%= m.text %></div>
                                <div class="msg-time"><%= m.timestamp %></div>
                            </div>
                        <% }) %>
                    </div>
                    <form id="chatForm" class="chat-input-area" onsubmit="sendMessage(event)">
                        <input type="text" id="messageInput" placeholder="Message..." autocomplete="off" required>
                        <button type="submit">Send</button>
                    </form>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Instagram Bottom Navigation Bar -->
    <div class="bottom-nav">
        <a href="/feed" class="nav-item">🏠</a>
        <button class="nav-item" onclick="openSearch()">🔍</button>
        <button class="nav-item" onclick="openModal()">➕</button>
        <a href="/chat" class="nav-item active">💬</a>
        <a href="/profile/<%= user.username %>" class="nav-item">👤</a>
    </div>

    <!-- Post Upload Modal -->
    <div id="postModal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal()">&times;</span>
            <h3 style="margin-bottom: 15px; font-size: 18px;">Create New Post</h3>
            <form action="/post" method="POST" enctype="multipart/form-data">
                <input type="file" name="image" accept="image/*" required style="margin-bottom: 12px; color: #fff;">
                <input type="text" name="content" placeholder="Write a caption..." required>
                <button type="submit">Share Post</button>
            </form>
        </div>
    </div>

    <!-- Search Modal Overlay -->
    <div id="searchModal" class="search-modal">
        <div class="search-header">
            <input type="text" id="searchInput" placeholder="Search username..." onkeyup="performSearch()">
            <button onclick="closeSearch()" style="background:none; border:none; color:#fff; font-size:16px;">Cancel</button>
        </div>
        <div id="searchResults" class="search-results-list"></div>
    </div>

    <!-- Socket.io Client Script -->
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io();
        const receiverUsername = "<%= chatUser ? chatUser.username : '' %>";
        const currentUsername = "<%= user.username %>";

        // Scroll to bottom of messages on load
        window.onload = function() {
            const box = document.getElementById('messagesBox');
            if (box) box.scrollTop = box.scrollHeight;
        };

        function sendMessage(e) {
            e.preventDefault();
            const input = document.getElementById('messageInput');
            const text = input.value.trim();
            if(!text || !receiverUsername) return;

            socket.emit('send_message', { receiver: receiverUsername, text: text });
            input.value = '';
        }

        socket.on('receive_message', (msg) => {
            if (msg.sender === receiverUsername || msg.receiver === receiverUsername) {
                const box = document.getElementById('messagesBox');
                if (box) {
                    const isSent = msg.sender === currentUsername;
                    const bubble = document.createElement('div');
                    bubble.className = `msg-bubble ${isSent ? 'sent' : 'received'}`;
                    bubble.innerHTML = `<div>${msg.text}</div><div class="msg-time">${msg.timestamp}</div>`;
                    box.appendChild(bubble);
                    box.scrollTop = box.scrollHeight;
                }
            }
        });

        function performChatSearch() {
            let query = document.getElementById('chatSearchInput').value;
            if(query.trim() === '') {
                document.getElementById('chatSearchResults').innerHTML = '<p style="color: #666; font-size: 13px; text-align: center; margin-top: 40px;">Search a username to start chatting.</p>';
                return;
            }
            fetch('/search?q=' + query)
            .then(res => res.json())
            .then(users => {
                let html = '';
                users.forEach(u => {
                    if (u.username !== currentUsername) {
                        html += `<a href="/chat/${u.username}" class="user-search-item"><b>@${u.username}</b></a>`;
                    }
                });
                document.getElementById('chatSearchResults').innerHTML = html || '<p style="color: #666; font-size: 13px; text-align: center; margin-top: 40px;">No users found.</p>';
            });
        }

        function openModal() { document.getElementById('postModal').style.display = 'flex'; }
        function closeModal() { document.getElementById('postModal').style.display = 'none'; }
        
        function openSearch() { document.getElementById('searchModal').style.display = 'flex'; document.getElementById('searchInput').focus(); }
        function closeSearch() { document.getElementById('searchModal').style.display = 'none'; }

        function performSearch() {
            let query = document.getElementById('searchInput').value;
            if(query.trim() === '') {
                document.getElementById('searchResults').innerHTML = '';
                return;
            }
            fetch('/search?q=' + query)
            .then(res => res.json())
            .then(users => {
                let html = '';
                users.forEach(u => {
                    html += `<a href="/profile/${u.username}" class="user-search-item"><b>@${u.username}</b></a>`;
                });
                document.getElementById('searchResults').innerHTML = html;
            });
        }
    </script>
</body>
</html>
